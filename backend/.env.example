# --- Server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- LLM (Groq) ---
# Get a key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# --- Rime (voice generation) ---
# Get a key from https://app.rime.ai
RIME_API_KEY=
RIME_SPEAKER=celeste
RIME_MODEL=coda

# --- Qdrant (conversation memory / retrieval / benchmarking) ---
# Qdrant Cloud: https://cloud.qdrant.io  (free tier cluster is enough for this project)
# Local dev alternative: run `docker compose up qdrant` from the repo root and use
# QDRANT_URL=http://localhost:6333 with QDRANT_API_KEY left blank.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=interview_answers

# If any of the above keys are missing, the server still runs in DEMO MODE:
# it falls back to a static question bank, a heuristic evaluator, and skips
# Qdrant/Rime calls (logging a warning once). This lets you develop the UI
# without every credential provisioned yet, but a submission/deployment
# should have all three keys set.
